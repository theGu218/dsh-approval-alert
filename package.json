{
  "name": "dsh-approval-alert",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "DSH 待授权提醒插件：当有工具调用或提问等待用户批准时，播放提示音并让最小化/后台窗口的任务栏图标闪烁，避免关掉窗口后错过授权。",
  "license": "MIT",
  "author": "theGu218",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theGu218/dsh-approval-alert.git"
  },
  "homepage": "https://github.com/theGu218/dsh-approval-alert#readme",
  "bugs": {
    "url": "https://github.com/theGu218/dsh-approval-alert/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "approval",
    "notification",
    "alert",
    "授权",
    "提醒"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/scheduler.js && node --check lib/win32.js",
    "test": "node --test test/"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
